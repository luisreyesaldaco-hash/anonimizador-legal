{
  "description": "Guardia del anonimizador: impide que Claude abra originales, tablas o resultados con datos reales.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python)\" \"${CLAUDE_PLUGIN_ROOT}/hooks/guardia.py\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
